# Copy to server/.env and set real values locally. NEVER commit .env.
# On Render, set these in the Web Service Environment settings instead.
PORT=8787
APP_NAME=Pulse Intake
# For local development only. On Render set CLIENT_URL to the deployed frontend
# (comma-separated list supported, e.g. http://localhost:5173,https://client.onrender.com).
CLIENT_URL=http://localhost:5173
# REQUIRED: create a Sarvam API key and add it here / in Render Environment settings.
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_REQUEST_TIMEOUT_MS=15000
