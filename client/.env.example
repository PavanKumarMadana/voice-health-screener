# Copy to client/.env for local development if you need to override the default.
# NEVER commit a real .env. VITE_* variables are inlined at build time.
#
# Local development default (no file needed): ws://localhost:8787/ws
#
# On Render, the Static Site sets VITE_API_URL to the deployed backend URL
# (e.g. https://voice-health-screener-server.onrender.com). The client then builds
# the WebSocket URL automatically: wss://.../ws
#
# You can override the WebSocket URL explicitly instead:
VITE_WS_URL=ws://localhost:8787/ws
# VITE_API_URL=https://your-app-name.onrender.com